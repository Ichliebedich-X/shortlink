# Copy this file to .env, then change the password in both places.
# MYSQL_DSN must use the same password as MYSQL_ROOT_PASSWORD.
# Do not commit the real .env file.
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DSN=root:change-me@tcp(mysql:3306)/shortlink?charset=utf8mb4&parseTime=True&loc=Local
REDIS_ADDR=redis:6379
